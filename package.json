{
  "name": "crypthy",
  "version": "0.2.0",
  "private": true,
  "author": "Ruderud",
  "license": "MIT",
  "description": "Coin mining hub + PC manager for Windows/NVIDIA: miner recommendations with repo links, GPU dashboard, fan/temperature safety stop, power limits, mining and profit tracking",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ruderud/crypthy.git"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "start:mock": "npm run build && CRYPTHY_MOCK=1 electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never && node scripts/checksums.mjs"
  },
  "build": {
    "appId": "io.github.ruderud.crypthy",
    "productName": "Crypthy",
    "artifactName": "Crypthy-${version}-win-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ps",
        "to": "ps",
        "filter": [
          "*.ps1"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Ruderud",
        "repo": "crypthy",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Crypthy-${version}-setup-${arch}.${ext}",
      "license": "LICENSE"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "lightweight-charts": "5.2.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
